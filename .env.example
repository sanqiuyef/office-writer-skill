# Optional runtime settings. Copy to .env or export in your shell.
# No API keys or paid services are required by this skill.

# Optional: explicit path to the dsoffice CLI (otherwise found on PATH).
MCP_OFFICE_DSOFFICE=
# Legacy alias used by some wrappers; MCP_OFFICE_DSOFFICE wins when both are set.
MODULE_OFFICE_DSOFFICE=

# Conversion/render/recalculation backend: auto | dsoffice | com | none.
# auto prefers dsoffice, then Microsoft Office COM, then WPS COM.
OFFICE_CONVERT_BACKEND=auto

# Optional: Tesseract executable for scanned-PDF OCR.
# Preferred variable; if unset, TESSERACT_CMD and shutil.which("tesseract") are tried.
OFFICE_TESSERACT_CMD=
# Legacy alias, still supported.
TESSERACT_CMD=

# Optional OCR switches (see references/conversion.md and reader.py).
MCP_OFFICE_OCR=1
MCP_OFFICE_OCR_LANG=chi_sim+eng
MCP_OFFICE_OCR_DPI=300
MCP_OFFICE_OCR_MAX_PAGES=0
MCP_OFFICE_OCR_MIN_TEXT_CHARS=500
